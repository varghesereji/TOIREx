[TANSPEC_LR]

ContinuumFile = data/TANSPEC/LR/traces/bg_removed_star.fits
ApertureLabel = data/TANSPEC/LR/traces/ApLabel_bg_removed_star.npy
ApertureTraceFilename = data/TANSPEC/LR/traces/TANSPEC_lr_trace.pkl

LampTrace_dict = data/TANSPEC/LR/wltemplates/
LampTrace_nameformat = tanspecArNe{}_template.npy

StdSky = data/TANSPEC/LR/Sky_spectra/Sky_spectra_lr.fits

Response = data/TANSPEC/LR/response_curve/response_curve.npy

[TANSPEC_XD]
ContinuumFile = data/TANSPEC/XD/traces/Skysubt_trace_hd37725xd_s4.0.fits
ApertureLabel = data/TANSPEC/XD/traces/aperturetracelabel_skysubt_hd37725_xd_s4.0.npy
ApertureTraceFilename = data/TANSPEC/XD/traces/aperturetrace_skysubt_hd37725_xd_s4.0.pkl

LampTrace_dict = data/TANSPEC/XD/wltemplates/
LampTrace_nameformat = tanspecArNe{}_template.npy

StdSky = data/TANSPEC/XD/Sky_spectra/Sky_spectra_xd.fits

Response = data/TANSPEC/XD/response_curve/response_curve.npy

[TIRSPEC]
ContinuumFile = data/TIRSPEC/traces/{}/Slope-18SCO_{}.fits
ApertureLabel = data/TIRSPEC/traces/{}/trace_tirspec_{}.npy
ApertureTraceFilename = data/TIRSPEC/traces/{}/trace_tirspec_{}.pkl

BadPixelMask = data/TIRSPEC/mask/TIRSPECH1RG_badpixelmask.npy